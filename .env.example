# =============================================================================
# mcp-ops-kb Configuration (.env)
# =============================================================================

# Caminho para o diretório de runbooks operacionais em Markdown
OPS_KB_RUNBOOKS_DIR=./runbooks

# Komodo Core API (RPC POST /read)
KOMODO_URL=https://komodo.ccm.local
KOMODO_API_KEY=
KOMODO_API_SECRET=
KOMODO_VERIFY_SSL=false

# Prometheus HTTP API (/api/v1/query, /api/v1/alerts)
PROMETHEUS_URL=http://prometheus.ccm.local:9090
PROMETHEUS_TOKEN=
PROMETHEUS_VERIFY_SSL=false

# Modo Demo / Fallback: quando true, retorna telemetria simulada realista do parque
# caso as credenciais do Komodo/Prometheus não estejam definidas ou a VPN esteja desconectada.
OPS_KB_DEMO_MODE=true
OPS_KB_HTTP_TIMEOUT=10.0
